{
  "manifest_version": 3,
  "name": "Relist",
  "version": "0.1.0",
  "description": "Send Vinted listing data to your Relist account.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.vinted.co.uk/*", "https://www.vinted.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Relist" },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.co.uk/items/*", "https://www.vinted.com/items/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
